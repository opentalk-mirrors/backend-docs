#!/bin/bash

set -xe

SCRIPT_DIR=$(dirname "$0")
# shellcheck source=ci/include/clone.sh
. "$SCRIPT_DIR"/include/clone.sh
REPO_NAME=${REPO_NAME_ROOMSERVER:-opentalk/backend/services/roomserver}
REPO_BRANCH=${REPO_BRANCH_ROOMSERVER:-main}

clone_repo "$REPO_NAME" "$REPO_BRANCH"

mkdir -p admin-docs/roomserver

deploy_to admin-docs/roomserver ".tmp/$REPO_NAME/docs/admin/*"
