#
# Shared redirect rules, imported by both the production Caddyfile and the
# dev Caddyfile.dev via `import Caddyfile.redirects`.

# redirections for compatibility with previous versions of the docs page
redir /de/redocusaurus/controller-rest.yaml /latest/developer/controller/api.yaml permanent
redir /de/user/FAQ* /latest/user/de/FAQ/ permanent
redir /de/user/manual* /latest/user/de/guide permanent
redir "/de/user/Handbuch/Abstimmungen und Umfragen mit OpenTalk*" /latest/user/de/guide/votings-and-polls/ permanent
redir "/de/user/Handbuch/Aufnahmefunktion*" /latest/user/de/guide/recording/ permanent
redir "/de/user/Handbuch/Breakout-Räume in OpenTalk*" /latest/user/de/guide/breakout-rooms/ permanent
