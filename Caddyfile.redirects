redir "/de/user/Technische Dokumentation/WebRTC Logs*" /latest/user/de/technical-documentation/webrtc-logs/ permanent
redir "/de/user/Technische Dokumentation/*" /latest/user/de/technical-documentation/ permanent
redir "/de/user/Troubleshooting/Absturz*" /latest/user/de/troubleshooting/crash/ permanent
