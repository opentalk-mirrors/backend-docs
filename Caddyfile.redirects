redir /developer/controller/rest/ /latest/developer/controller/api

@old_admin path_regexp ^/admin/(.*)$
redir @old_admin /latest/admin/{re.1}

@old_developer path_regexp ^/developer/(.*)$
redir @old_developer /latest/developer/{re.1}

@latest path_regexp /latest/(.*)$
redir @latest /26.1/{re.1}

@user_de {
    path_regexp /([0-9]+\.[0-9]+)/user\/?$
    header Accept-Language de*
}
redir @user_de /{re.1}/user/de

@user_general path_regexp /([0-9]+\.[0-9]+)/user\/?$
redir @user_general /{re.1}/user/en

@old_releases_path path_regexp /releases/releases/([0-9]+\.[0-9]+\.[0-9]+)\/?$
redir @old_releases_path /releases/{re.1} permanent

@old_de path_regexp ^/de/(.*)$
redir @old_de /{re.1} permanent
