/.cache
/.tmp/
/site

# It appears gitignore doesn't understand full regex, but only character ranges.
# We're matching a permutation of all combinations from 1 to 3 digits before and
# after the dot, that should be sufficient.
docs/1.*
docs/24.*
docs/25.0
docs/25.1

docs/25.2/navigation.md
docs/25.2/README.md
docs/25.2/admin/*
!docs/25.2/admin/README.md
docs/25.2/developer/*
!docs/25.2/developer/README.md
docs/25.2/user/

docs/25.3/navigation.md
docs/25.3/README.md
docs/25.3/admin/*
!docs/25.3/admin/README.md
docs/25.3/developer/*
!docs/25.3/developer/README.md
docs/25.3/user/
docs/25.3/architecture/

